# ============================================================
# XAUUSDm Trend Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env to git or share it with anyone.
# ============================================================

# --- MT5 CONNECTION ---
# Your server name appears in the top bar of MT5 desktop:
# e.g. "Exness-MT5Trial9" for your current demo account
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-ServerName

# --- SAFETY GATE ---
# Must be explicitly set to true before the bot will trade on a live account.
# On a demo account this does nothing — it only blocks accidental live deployment.
I_UNDERSTAND_THIS_IS_LIVE=false

# --- BROKER & SYMBOL SETTINGS ---
# Use the exact name shown in your MT5 Market Watch. Exness uses a lowercase "m".
SYMBOL=XAUUSDm
# On Gold, 1 pip is usually $0.01 movement (0.01).
PIP_SIZE=0.01
# Maximum acceptable slippage for entry/exit orders (in points, 10 points = 1 pip)
# 50 points = 5 pips, ensuring your orders aren't rejected during high volatility.
MAX_SLIPPAGE_POINTS=50
# Initial trade size.
LOT_SIZE=0.01

# --- RISK & TRADE MANAGEMENT ---
# The strategy's validated stop loss parameters (based on 1 yr backtest)
INITIAL_STOP_PIPS=500
TRAIL_PIPS=150
# Global limit on how many positions the bot can have open simultaneously.
MAX_CONCURRENT_TRADES=5

# --- ENTRY SIGNAL PARAMETERS ---
# Core timeframe for signal generation. M5 is the validated timeframe.
TIMEFRAME=M5
# EMA Crossover parameters (Fast EMA crossing Slow EMA triggers an entry signal)
EMA_FAST=9
EMA_SLOW=21

# --- HIGHER TIMEFRAME (HTF) FILTER ---
# When enabled, the bot checks the macro trend before taking an M5 signal.
# Example: If M5 says BUY, but the current price is below the H1 EMA50, it skips.
HTF_FILTER_ENABLED=false
HTF_TIMEFRAME=H1
HTF_EMA_PERIOD=50

# --- ADX TREND FILTER ---
# The bot only takes entries when ADX is above this threshold (meaning trend is strong).
ADX_PERIOD=14
ADX_THRESHOLD=20

# --- SELF-TUNING (ADX Auto-Adjustment) ---
# Every N closed trades, the bot analyzes performance and suggests adjusting ADX.
TUNING_REVIEW_EVERY_N_TRADES=20
ADX_TUNE_STEP=1.0
ADX_THRESHOLD_MIN=15
ADX_THRESHOLD_MAX=35
# If false, logs suggestions to the DB for manual review. If true, auto-updates ADX.
AUTO_APPLY_TUNING=false

# --- PERFORMANCE TUNING ---
# How often the bot scans for new signals and updates the trailing stops.
# 5 seconds is recommended to minimize latency on fast Gold movements.
POLL_INTERVAL_SECONDS=5
# How much historical data to fetch per API call.
BARS_TO_FETCH=100