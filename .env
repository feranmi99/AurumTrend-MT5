# ============================================================
# XAUUSDm Trend Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env to git or share it with anyone.
# ============================================================

# --- MT5 CONNECTION ---
MT5_LOGIN=436319086
MT5_PASSWORD=@Olamilekan99
MT5_SERVER=Exness-MT5Trial9
# Your server name appears in the top bar of MT5 desktop:
# e.g. "Exness-MT5Trial9" for your current demo account

# --- SAFETY GATE ---
# Must be explicitly set to true before the bot will trade on a live account.
# On a demo account this does nothing — it only blocks accidental live deployment.
I_UNDERSTAND_THIS_IS_LIVE=false

# --- SYMBOL ---
SYMBOL=XAUUSDm
# Use the exact name shown in your MT5 Market Watch.
# Your broker appends a lowercase "m" — do not change this.

# --- TIMEFRAME ---
# M5 is the validated timeframe from backtesting.
# M1 was tested and performed worse due to noise at these stop distances.
TIMEFRAME=M5

# --- POSITION SIZING ---
# Start at 0.01 (minimum micro lot). Do NOT increase this until the bot
# has completed the demo validation phase (minimum 200 trades or 4 weeks).
# See EQUITY_SCALING_ENABLED below for how to grow lot size safely over time.
LOT_SIZE=0.01

# --- ENTRY SIGNAL PARAMETERS ---
# These values are validated across a full year of XAUUSDm M5 data (Jun 2025 - Jun 2026).
# Do not change them without re-running the backtest against new data.

# EMA crossover periods (fast crosses slow = entry signal)
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# ADX trend strength filter — only take entries when ADX is above this threshold.
# Filters out choppy, low-trend conditions where EMA crosses are mostly noise.
ADX_PERIOD=14
ADX_THRESHOLD=20

# Higher timeframe trend filter (H1 EMA50)
# When enabled, only takes M5 signals that align with the H1 trend direction.
# This roughly halved the drawdown in backtesting (4,910 pips → 2,677 pips)
# at a small cost to raw expectancy — strongly recommended for a small account.
HTF_FILTER_ENABLED=true
HTF_TIMEFRAME=H1
HTF_EMA_PERIOD=50

# --- EXIT / STOP PARAMETERS ---
# These are the single most important numbers in the strategy.
# Validated through a sweep of 5/7/10/15 pip combinations on a full year of data.

# Initial fixed stop-loss distance from entry (in pips).
# At 15 pips, the strategy hit a profit factor of 1.39 (M5, no H1 filter)
# and 1.28 (M5, with H1 filter). Tighter stops (5-10 pips) were tested and
# performed significantly worse — gold's normal M5 noise clips them before
# real moves develop.
INITIAL_STOP_PIPS=15

# Trailing stop distance once the trade is in profit (in pips).
# The trailing stop ONLY activates once price is in profit — while the trade
# is at a loss, the stop stays fixed at the initial level.
# Once in profit, the stop trails at this distance, locking gains as price moves.
# It never loosens — it only ever moves in the trade's favor.
# 7 pips was the best-performing trail distance paired with a 15-pip initial stop.
TRAIL_PIPS=7

# No take-profit is used. The ONLY exit mechanism is the stop-loss (initial or
# trailing). This is intentional — the strategy's edge comes from letting
# large winners run until price reverses, not capping them at a fixed target.
# DO NOT add a take-profit without re-running the backtest first.

# --- POLLING / SCAN INTERVAL ---
# How often (in seconds) the bot checks for new signals when not in a position.
# 10 seconds is a sensible default for M5 — checking faster than every 5 seconds
# on M5 bars provides no additional signal quality and wastes CPU/API calls.
SCAN_INTERVAL_SECONDS=10

# How often (in seconds) the bot updates the trailing stop on an open position.
# More frequent = tighter lock on fast moves. 5 seconds is a good balance.
TRAIL_UPDATE_INTERVAL_SECONDS=5

# --- EQUITY-TIED POSITION SCALING (optional, disabled by default) ---
# When enabled, the bot slightly increases lot size as account equity grows.
# This compounds returns over time WITHOUT increasing risk percentage per trade.
# This is NOT martingale — lot size never increases after a loss, only after
# the account balance itself has grown above a threshold.
# Leave disabled until the bot has completed the full demo validation phase.
EQUITY_SCALING_ENABLED=false
# Base balance the scaling is calibrated from (set to your starting deposit)
EQUITY_SCALING_BASE=50
# Lot size increases by this amount for every X dollars of equity growth above base
EQUITY_SCALING_LOT_STEP=0.01
EQUITY_SCALING_EQUITY_STEP=50
# Example: with the above defaults, lot size increases by 0.01 for every $50
# of equity growth: $50 account = 0.01 lot, $100 account = 0.02 lot, etc.
# Maximum lot size the scaling is allowed to reach (hard cap)
EQUITY_SCALING_MAX_LOT=0.10

# --- SELF-TUNING (ADX threshold auto-adjustment) ---
# After every N closed trades, the bot analyzes whether raising or lowering the
# ADX threshold would have improved recent results, and suggests (or auto-applies)
# a small adjustment. See tuning.py for the full logic.
TUNING_ENABLED=true
TUNING_LOOKBACK_TRADES=20
# Range the auto-tuner is allowed to move the ADX threshold within
TUNING_ADX_MIN=15
TUNING_ADX_MAX=30
TUNING_ADX_STEP=1
# false = log the suggestion but require manual approval via POST /tuning/approve
# true = apply suggestions automatically (only enable after demo validation)
AUTO_APPLY_TUNING=false

# --- DEMO VALIDATION GATE ---
# The bot will log a warning and refuse to switch to live trading until BOTH
# of these thresholds are met on demo. This is a hard requirement, not optional.
# Minimum number of closed trades on demo before live is considered
DEMO_MIN_TRADES=200
# Minimum number of calendar days running on demo before live is considered
DEMO_MIN_DAYS=28
